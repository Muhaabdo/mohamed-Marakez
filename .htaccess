# Serve index.html at the site root
DirectoryIndex index.html

Options -MultiViews
RewriteEngine On

# Removed page: old projects hub -> homepage projects section
RewriteRule ^marakez-projects(\.html)?/?$ /#projects [R=301,L,NE]

# /index.html -> / (avoid a duplicate URL for the homepage)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [R=301,L]

# /page.html -> /page (drop the .html extension from every other URL)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /(.+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Internally serve the matching .html file for the extension-less URL
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]

# HTML pages: always revalidate with the server, so price and content
# updates show immediately (images, CSS and JS keep their own caching).
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
